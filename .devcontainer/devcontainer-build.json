{
  "name": "devcontainer-build",
  // Pinned to bookworm (Debian 12): the rolling `:debian` tag now resolves to
  // trixie (Debian 13), which the docker-in-docker feature's Moby apt
  // packages don't yet support ("Unsupported distribution version 'trixie'").
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",

  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    // Registry features
    "ghcr.io/devcontainers/features/go:1": {
      // Primary dev toolchain. CI also exercises 1.25 (see
      // .github/workflows/ci.yml matrix); go.mod declares go 1.25.0.
      "version": "1.26"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:1": {
      // Use Compose v2 (the `docker compose` CLI plugin), which is what the
      // integration suite calls. The default "v1" has no arm64 standalone
      // binary, so the feature falls back to `pip install docker-compose`,
      // which fails on bookworm under PEP 668 (externally-managed-environment).
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "make"
    },

    // Local features
    "./features/golangci-lint": { "version": "2.5.0" }
  }
}
